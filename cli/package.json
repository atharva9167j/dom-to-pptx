{
  "name": "dom-to-pptx-cli",
  "version": "1.0.0",
  "description": "CLI tool to convert HTML to PPTX on server",
  "main": "html2pptx.js",
  "bin": {
    "html2pptx": "./html2pptx.js"
  },
  "scripts": {
    "convert": "node html2pptx.js",
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "playwright": "^1.58.0",
    "zod": "^4.3.6"
  }
}
